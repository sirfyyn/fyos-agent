{
  "id": "fyos-speed-router",
  "name": "FYOS speed router",
  "version": "2026.10.2",
  "description": "Optional fail-closed routing of short conversational direct turns to a small fast model. Off unless enabled and targetModel is set.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean" },
      "targetModel": { "type": "string" },
      "maxChars": { "type": "integer", "minimum": 1, "maximum": 1000 },
      "agentId": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  }
}
